    "reason": "The first threshold commands stopped before archive access because the immutable pilot lock referenced the historical profile. Version 2 adds explicit historical-profile and runner lineage verification; estimator and selector semantics are unchanged."
  },
  "calibration_selection": {
    "structures": ["CCPs", "ER"],
    "partition": "threshold_calibration",
    "rule": "Use every reference field assigned by sha256('BioSR-v9|' + structure + '|' + reference_group_id) first_uint64 modulo 4 in remainders 2 or 3.",
    "pixel_or_reference_outcome_selection": false,
    "score_design_overlap_allowed": false
  },
  "claim_endpoints": [
    "hessian_blob_curve",
    "hessian_tube_curve",
    "spectral_anisotropy",
    "spectral_entropy",
    "tensor_coherence",
    "tensor_orientation",
    "variogram_horizontal_curve",
    "variogram_vertical_curve",
    "variogram_range_horizontal",
    "variogram_range_vertical"
  ],
  "score": {
    "condition": "full_contract",
    "aggregation": "maximum",
    "components": [
      "acquisition_qc",
      "physical_sampling",
      "perturbation_stability",
      "measurement_identifiability"
    ],
    "cross_scale_agreement": "diagnostic_only"
  },
  "threshold_selector": {
    "candidate_rule": "Tied observed full-contract scores among reference-eligible, non-hard-abstention calibration cases.",
    "selection_rule": "Select the highest-coverage candidate satisfying every aggregate and assessable structure-endpoint constraint; do not tune endpoints or score components.",
    "target_overall_and_structure_endpoint_observed_risk": 0.1,
    "maximum_stratified_reference_field_cluster_bootstrap_overall_risk_upper95": 0.15,
    "minimum_overall_coverage": 0.8,
    "minimum_assessable_structure_endpoint_coverage": 0.7,
    "minimum_aurc_reduction_fraction_vs_always_emit": 0.2,
    "bootstrap_replicates": 10000,
    "bootstrap_seed": 26082801,
    "bootstrap_strata": "structure",
    "bootstrap_cluster": "reference_group_id",
    "not_assessable_rule": "A structure-endpoint combination with zero reference-eligible cases is reported as not assessable and cannot be called a pass.",
    "failure_rule": "If no operating point passes, threshold calibration fails and these fields cannot be used for further tuning."
  },
  "comparators": {
    "primary": "always_emit",
    "ordinary_qc": "conventional_acquisition_qc evaluated under the identical risk and coverage selector",
    "interpretation": "A pass versus always emit does not imply superiority to conventional QC; the QC comparison must be reported without spin."
  },
